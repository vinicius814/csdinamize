      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/rpc/dcs_reservar_jobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_tipo: \"pipedrive_atividade_diagnostico\", p_limite: 10 }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "DCS · Supabase service role"
        }
      }
    },
    {
      "id": "7a0d333e-9a95-52a2-9492-8dc07c4de5e4",
      "name": "Um item por job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((i) => i.json).flat().filter((j) => j && j.id).map((j) => ({ json: j }));"
      }
    },
    {
      "id": "85e6df3f-a7da-54f6-a3b4-b125e550374e",
      "name": "Atividades do negócio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "url": "https://api.pipedrive.com/api/v2/activities",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pipedriveApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "deal_id",
              "value": "={{ $json.payload.deal_id }}"
            },
            {
              "name": "limit",
              "value": "500"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000,
      "credentials": {
        "pipedriveApi": {
          "id": "",
          "name": "DCS · Pipedrive (cs-dinamize)"
        }
      }
    },
    {
      "id": "a7ad5a1d-801b-56bf-b91f-9a2774be205f",
      "name": "Já existe?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst out = [];\nconst jobs = $('Um item por job').all();\n$input.all().forEach((it, i) => {\n  const job = jobs[i].json;\n  const ja = (it.json.data || []).find((a) => String(a.note || '').includes(job.payload.marca));\n  out.push({ json: { job, existente: ja ? ja.id : null } });\n});\nreturn out;\n"
      }
    },
    {
      "id": "4ba0518d-1047-59c4-ba22-7e1ce79ba8fd",
      "name": "Criar atividade?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c",
              "leftValue": "={{ !$json.existente }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b3aea22d-2c80-5ddd-a71d-969b7506ec63",
      "name": "Criar atividade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.pipedrive.com/api/v2/activities",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pipedriveApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: $json.job.payload.subject, type: 'anlise', done: true, deal_id: $json.job.payload.deal_id, org_id: $json.job.payload.org_id, owner_id: $json.job.payload.owner_id, due_date: $now.setZone('America/Sao_Paulo').toISODate(), note: ($json.job.payload.resumo || '').replace(/\\n/g, '<br>') + '<br><br>' + $json.job.payload.marca }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "pipedriveApi": {
          "id": "",
          "name": "DCS · Pipedrive (cs-dinamize)"
        }
      }
    },
    {
      "id": "e7e47d95-5c08-5b3b-8a13-695828b80a7f",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst job = $('Criar atividade?').item.json.job;\nconst r = $json;\nconst id = r.body?.data?.id;\n// Sem status ou erro de rede = resposta ambígua: o próximo ciclo confere pela marca antes de recriar.\nconst status = id ? 'concluido' : (!r.statusCode || r.statusCode >= 500) ? 'ambiguo' : 'falha';\nreturn { json: { p_id: job.id, p_status: status, p_resultado: id ? { activity_id: id } : null, p_erro: id ? null : JSON.stringify(r.body || r.error || {}).slice(0, 500) } };\n"
      }
    },
    {
      "id": "31bdd75c-6bf6-5a3b-ab6f-61f687fd2724",
      "name": "Finalizar job",
      "type": "n8n-nodes-base.httpRequest",
